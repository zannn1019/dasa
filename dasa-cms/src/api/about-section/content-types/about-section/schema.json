    },
    "gallery": {
      "type": "component",
      "component": "shared.slider",
      "repeatable": true
    },
    "certifications": {
      "type": "component",
      "component": "shared.certifications",
      "repeatable": true
    },
    "stats": {
      "type": "component",
      "component": "shared.stat-item",
      "repeatable": true
    },
    "capabilities": {
      "type": "component",
      "component": "shared.capability",
      "repeatable": true
    }
